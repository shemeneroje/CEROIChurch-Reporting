rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Role-based access control for reports
    match /reports/{reportId} {
      allow read: if canReadReport();
      allow write: if request.auth != null; // any signed-in user can submit
    }

    function canReadReport() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let report = resource.data;

      return
        // Zonal Pastor — all reports
        (user.role == "Zonal Pastor") ||

        // Group Pastor — same group
        (user.role == "Group Pastor" && user.group == report.group) ||

        // Admin / Church Pastor — same church
        ((user.role == "Admin" || user.role == "Church Pastor") &&
         user.church == report.church) ||

        // Regular User — their own report
        (user.role == "User" && user.uid == report.uid);
    }
  }
}
